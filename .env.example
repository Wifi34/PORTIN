REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default zero-config local SQLite (instant startup for presentations):
DATABASE_URL="sqlite:///./portin.db"

# Or Production PostgreSQL (Supabase / Neon / Render / AWS RDS):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. OPENAI GPT REASONING API (For PortIN Decision Advisor)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ------------------------------------------------------------------------------
# 4. GMAIL SMTP (Official Password Reset & Alert Delivery)
# ------------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
# 16-character Google App Password (generate at: https://myaccount.google.com/apppasswords)
