PROJECT_NAME="PortIN Maritime Freight Intelligence"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 1. SECURITY & TOKENS
# ------------------------------------------------------------------------------
JWT_SECRET="sih-2026-portin-sail-secret-key-production-strength-marine-logistics-991823"
